{
  "name": "@resolvingarchitecture/ra-common",
  "version": "0.1.0",
  "description": "Resolving Architecture - Common - TypeScript. Core messaging, identity, crypto and content types for the RA / 1M5 ecosystem.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "messaging",
    "envelope",
    "identity",
    "did",
    "crypto",
    "resolving-architecture"
  ],
  "author": "Brian Taylor <brian@resolvingarchitecture.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resolvingarchitecture/ra-common-ts.git"
  },
  "homepage": "https://resolvingarchitecture.io",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
